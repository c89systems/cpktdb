cmake_minimum_required(VERSION 3.21)
file(GLOB headers "${CPKT_SOURCE}/include/cpkt/*.h")
set(comment "/\\*([^*]|\\*+[^*/])*\\*+/")
set(documented "/\\*\\*([^*]|\\*+[^*/])*\\*+/[ \t\n]*[^;{}]*;")
set(missing "")
foreach(header IN LISTS headers)
  file(READ "${header}" content)
  # The database API deliberately documents related declarations as Doxygen
  # families. Keep that established ownership/lifetime documentation contract.
  if(content MATCHES "@defgroup cpkt_sqlite")
    string(REGEX MATCHALL "@\\{" opened "${content}")
    string(REGEX MATCHALL "@\\}" closed "${content}")
    list(LENGTH opened open_count)
    list(LENGTH closed close_count)
    if(NOT content MATCHES "@name " OR NOT open_count EQUAL close_count)
      message(FATAL_ERROR "Unbalanced or missing SQLite API family documentation")
    endif()
    continue()
  endif()
  # This check covers the project's ordinary C function declarations.
  # Type/family ownership documentation and source definitions are reviewed
  # under the public API contract; this is not a general C parser.
  string(REGEX MATCHALL "${documented}" comments "${content}")
  string(REGEX REPLACE "${comment}" "" bare "${content}")
  string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "\n" bare "${bare}")
  string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_* \t\n]*[ *\t\n]cpkt_[A-Za-z0-9_]+[ \t\n]*\\([^;{}]*;" declarations "${bare}")
  string(REGEX REPLACE "${comment}" "" comments "${comments}")
  foreach(declaration IN LISTS declarations)
    if(declaration MATCHES "(cpkt_[A-Za-z0-9_]+)[ \t\n]*\\(")
      set(name "${CMAKE_MATCH_1}")
      if(NOT comments MATCHES "${name}[ \t\n]*\\(")
        list(APPEND missing "${header}: ${name}")
      endif()
    endif()
  endforeach()
endforeach()
if(missing)
  list(JOIN missing "\n" missing)
  message(FATAL_ERROR "Public functions lack adjacent Doxygen contracts:\n${missing}")
endif()
