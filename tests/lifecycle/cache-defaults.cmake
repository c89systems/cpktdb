cmake_minimum_required(VERSION 3.21)
include("${CPKT_SOURCE_DIR}/cmake/CpktDependencyArchiveCache.cmake")
# Set every input explicitly; no fixture touches the workstation cache.
set(ENV{HOME} "${CPKT_TEST_ROOT}/home")
set(ENV{XDG_CACHE_HOME} "${CPKT_TEST_ROOT}/xdg cache")
set(ENV{CPKT_DEPENDENCY_CACHE} "${CPKT_TEST_ROOT}/environment")
set(CPKT_DEPENDENCY_CACHE "${CPKT_TEST_ROOT}/cmake")
cpkt_initialize_dependency_cache()
if(NOT CPKT_DEPENDENCY_CACHE STREQUAL "${CPKT_TEST_ROOT}/cmake")
  message(FATAL_ERROR "Explicit CMake cache does not take precedence")
endif()
unset(CPKT_DEPENDENCY_CACHE CACHE)
unset(CPKT_DEPENDENCY_CACHE)
cpkt_initialize_dependency_cache()
if(NOT CPKT_DEPENDENCY_CACHE STREQUAL "${CPKT_TEST_ROOT}/environment")
  message(FATAL_ERROR "Environment cache does not take precedence over XDG")
endif()
unset(CPKT_DEPENDENCY_CACHE CACHE)
unset(CPKT_DEPENDENCY_CACHE)
unset(ENV{CPKT_DEPENDENCY_CACHE})
cpkt_initialize_dependency_cache()
if(NOT CPKT_DEPENDENCY_CACHE STREQUAL "${CPKT_TEST_ROOT}/xdg cache/cpkt/deps")
  message(FATAL_ERROR "Wrong XDG dependency cache namespace")
endif()
unset(CPKT_DEPENDENCY_CACHE CACHE)
unset(CPKT_DEPENDENCY_CACHE)
unset(ENV{XDG_CACHE_HOME})
cpkt_initialize_dependency_cache()
if(NOT CPKT_DEPENDENCY_CACHE STREQUAL "${CPKT_TEST_ROOT}/home/.cache/cpkt/deps")
  message(FATAL_ERROR "Wrong HOME dependency cache namespace")
endif()

find_program(HOST_BASH bash REQUIRED)
foreach(selection xdg home explicit)
  set(xdg "")
  set(override "")
  set(expected "${CPKT_TEST_ROOT}/home/.cache/cpkt/toolchains")
  if(selection STREQUAL "xdg")
    set(xdg "${CPKT_TEST_ROOT}/xdg cache")
    set(expected "${xdg}/cpkt/toolchains")
  elseif(selection STREQUAL "explicit")
    set(xdg "${CPKT_TEST_ROOT}/xdg cache")
    set(override "${CPKT_TEST_ROOT}/explicit tools")
    set(expected "${override}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "CPKT_TOOLCHAIN_CACHE=${override}" "XDG_CACHE_HOME=${xdg}"
    "${HOST_BASH}" "${CPKT_SOURCE_DIR}/scripts/cpkt-toolchains.sh" discover x86_64-linux-gnu
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE error)
  string(FIND "\n${report}" "\ncache=${expected}\n" cache_field)
  string(FIND "\n${report}" "\nstatus=missing\n" status_field)
  if(NOT status EQUAL 0 OR cache_field LESS 0 OR status_field LESS 0)
    message(FATAL_ERROR "Incorrect ${selection} toolchain cache discovery: ${error}${report}")
  endif()
  if(EXISTS "${expected}")
    message(FATAL_ERROR "Read-only discovery created a cache directory")
  endif()
endforeach()
