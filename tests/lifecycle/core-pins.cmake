cmake_minimum_required(VERSION 3.21)
file(READ "${CPKT_SOURCE_DIR}/dependencies/cpkt.json" pins)
string(JSON count LENGTH "${pins}")
string(JSON schema GET "${pins}" schema_version)
string(JSON repository GET "${pins}" repository)
string(JSON version GET "${pins}" version)
if(NOT count EQUAL 4 OR NOT schema EQUAL 1 OR NOT repository STREQUAL "c89systems/cpkt"
    OR NOT version STREQUAL "0.3.0")
  message(FATAL_ERROR "Incorrect published core pin contract")
endif()
string(JSON count LENGTH "${pins}" targets)
if(NOT count EQUAL 7)
  message(FATAL_ERROR "Every shipped target needs an exact published core pin")
endif()
foreach(target x86_64-linux-gnu x86_64-linux-musl aarch64-linux-gnu aarch64-linux-musl
    armhf-linux-gnu armhf-linux-musl arm64-apple-darwin)
  string(JSON count LENGTH "${pins}" targets "${target}")
  string(JSON url GET "${pins}" targets "${target}" url)
  set(name "cpkt-${version}-${target}.tar.gz")
  if(NOT count EQUAL 3 OR NOT url STREQUAL
      "https://github.com/${repository}/releases/download/v${version}/${name}")
    message(FATAL_ERROR "Incorrect published core archive identity: ${target}")
  endif()
  foreach(field sha256 package_id)
    string(JSON value GET "${pins}" targets "${target}" "${field}")
    string(LENGTH "${value}" length)
    if(NOT length EQUAL 64 OR NOT value MATCHES "^[a-f0-9]+$")
      message(FATAL_ERROR "Invalid core ${field}: ${target}")
    endif()
  endforeach()
endforeach()
if(NOT CPKT_CORE_RELEASE_ASSETS)
  return()
endif()
set(name "cpkt-${version}-${CPKT_CORE_TARGET}.tar.gz")
string(JSON expected GET "${pins}" targets "${CPKT_CORE_TARGET}" sha256)
file(SHA256 "${CPKT_CORE_RELEASE_ASSETS}/${name}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Published core archive checksum mismatch: ${name}")
endif()
file(STRINGS "${CPKT_CORE_RELEASE_ASSETS}/cpkt-${version}-CHECKSUMS" checksums)
if(NOT "${expected}  ${name}" IN_LIST checksums)
  message(FATAL_ERROR "Core pin differs from the published checksum inventory: ${name}")
endif()
find_program(TAR tar REQUIRED)
execute_process(COMMAND "${TAR}" -xOf "${CPKT_CORE_RELEASE_ASSETS}/${name}"
  "cpkt-${version}-${CPKT_CORE_TARGET}/share/cpkt/packages/core.json"
  RESULT_VARIABLE status OUTPUT_VARIABLE manifest ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot inspect published core manifest: ${error}")
endif()
foreach(pair "group|core" "release_version|${version}" "target_id|${CPKT_CORE_TARGET}" "schema_version|1")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 key)
  list(GET pair 1 expected)
  string(JSON actual GET "${manifest}" "${key}")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Published core manifest ${key} mismatch")
  endif()
endforeach()
string(JSON actual GET "${manifest}" package_id)
string(JSON expected GET "${pins}" targets "${CPKT_CORE_TARGET}" package_id)
string(REPLACE "\"package_id\":\"${actual}\"," "" unsigned "${manifest}")
string(SHA256 calculated "${unsigned}")
if(NOT actual STREQUAL expected OR NOT calculated STREQUAL actual)
  message(FATAL_ERROR "Published core package identity mismatch: ${name}")
endif()
message(STATUS "Verified published archive and package identity: ${name}")
