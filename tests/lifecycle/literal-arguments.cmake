cmake_minimum_required(VERSION 3.21)
include("${CPKT_SOURCE_DIR}/cmake/CpktLiteralArguments.cmake")
foreach(value "[built in][v()]" "tail]" "tail]=" "tail]==" "a;b" "two words" "\nfirst newline")
  cpkt_literal_argument(literal "${value}")
  cmake_language(EVAL CODE "set(restored ${literal})")
  if(NOT restored STREQUAL value)
    message(FATAL_ERROR "Literal CMake argument changed")
  endif()
endforeach()
