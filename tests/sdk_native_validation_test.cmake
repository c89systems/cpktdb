cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
include(CMakePackageConfigHelpers)
set(work "${CPKT_SCRATCH}/sdk-validation")
file(REMOVE_RECURSE "${work}")

# These fixtures follow core 0.3.0's published AnyNewerVersion + floor contract.
function(core_fixture prefix version floor target)
  file(MAKE_DIRECTORY "${prefix}/lib/cmake/CpktCore" "${prefix}/include" "${prefix}/share/cpkt/packages")
  file(WRITE "${prefix}/include/sample.h" "int sample(void);\n")
  set(config [=[
get_filename_component(CpktCore_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
_cpktdb_sdk_validate_prefix("${CpktCore_PREFIX}" core)
file(READ "${CpktCore_PREFIX}/share/cpkt/packages/core.json" manifest)
string(JSON CpktCore_VERSION GET "${manifest}" release_version)
string(JSON CpktCore_TARGET_ID GET "${manifest}" target_id)
string(JSON CpktCore_PACKAGE_ID GET "${manifest}" package_id)
set(CpktCore_COMPATIBLE_SINCE "@floor@")
]=])
  string(CONFIGURE "${config}" config @ONLY)
  file(WRITE "${prefix}/lib/cmake/CpktCore/CpktCoreConfig.cmake" "${config}")
  set(version_file "${prefix}/lib/cmake/CpktCore/CpktCoreConfigVersion.cmake")
  write_basic_package_version_file("${version_file}" VERSION "${version}"
    COMPATIBILITY AnyNewerVersion ARCH_INDEPENDENT)
  file(READ "${version_file}" native_version)
  file(WRITE "${version_file}"
    "if(NOT \"\${PACKAGE_FIND_VERSION}\" STREQUAL \"\" AND\n"
    "    PACKAGE_FIND_VERSION VERSION_LESS \"${floor}\")\n"
    "  set(PACKAGE_VERSION \"${version}\")\n"
    "  set(PACKAGE_VERSION_COMPATIBLE FALSE)\n"
    "  set(PACKAGE_VERSION_EXACT FALSE)\n  return()\nendif()\n\n${native_version}")
  set(files "")
  set(separator "")
  foreach(path include/sample.h lib/cmake/CpktCore/CpktCoreConfig.cmake
      lib/cmake/CpktCore/CpktCoreConfigVersion.cmake)
    file(CHMOD "${prefix}/${path}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
    file(SHA256 "${prefix}/${path}" sha)
    string(APPEND files "${separator}{\"mode\":\"0644\",\"path\":\"${path}\",\"sha256\":\"${sha}\",\"type\":\"file\"}")
    set(separator ,)
  endforeach()
  string(REGEX REPLACE ".*-linux-" "" libc "${target}")
  set(before "{\"components\":[],\"files\":[${files}],\"group\":\"core\",\"libc\":\"${libc}\",\"macos_deployment_target\":null,")
  set(after "\"release_version\":\"${version}\",\"requires_core\":null,\"schema_version\":1,\"target_id\":\"${target}\"}")
  string(SHA256 id "${before}${after}")
  set(manifest "${before}\"package_id\":\"${id}\",${after}")
  file(WRITE "${prefix}/share/cpkt/packages/core.json" "${manifest}")
  set(core_id "${id}" PARENT_SCOPE)
  set(core_manifest "${manifest}" PARENT_SCOPE)
endfunction()

set(prefix "${work}/core SDK with spaces")
core_fixture("${prefix}" 0.3.0 0.2.0 x86_64-linux-gnu)
set(built_id "${core_id}")
set(baseline_manifest "${core_manifest}")
file(MAKE_DIRECTORY "${work}/source")
file(WRITE "${work}/source/CMakeLists.txt" [=[cmake_minimum_required(VERSION 3.21)
project(sdk_validation NONE)
set(owned unrelated-caller-value)
set(link_targets unrelated-caller-value)
include("${CPKT_ROOT}/cmake/CpktSDKValidate.cmake")
_cpktdb_sdk_validate_prefix("${PREFIX}" core)
]=])
set(configure "${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/graph"
  "-DCPKT_ROOT=${CPKT_ROOT}" "-DPREFIX=${prefix}" -DCMAKE_SYSTEM_NAME=Linux)
cpkt_test_command(${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)
cpkt_test_failure("SDK target mismatch" ${configure} -DCPKT_TARGET_ID=aarch64-linux-gnu)
file(WRITE "${prefix}/include/sample.h" "changed\n")
cpkt_test_failure("SDK payload differs" ${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)
file(WRITE "${prefix}/include/sample.h" "int sample(void);\n")
cpkt_test_command(${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)
string(REPLACE "0.3.0" "0.3.1" corrupt "${baseline_manifest}")
file(WRITE "${prefix}/share/cpkt/packages/core.json" "${corrupt}")
cpkt_test_failure("manifest identity mismatch" ${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)
file(WRITE "${prefix}/share/cpkt/packages/core.json" "${baseline_manifest}")

# Generate the real provider manifest and discovery preambles using a small SDK.
set(db "${work}/database SDK with spaces")
file(MAKE_DIRECTORY "${db}/lib/cmake/CpktDB" "${db}/lib/cmake/FixtureDB"
  "${db}/lib/pkgconfig" "${db}/include" "${work}/db-source")
file(COPY_FILE "${CPKT_ROOT}/cmake/CpktSDKValidate.cmake" "${db}/lib/cmake/CpktDB/Validate.cmake")
file(WRITE "${db}/include/db.h" "int database(void);\n")
file(WRITE "${db}/lib/cmake/FixtureDB/FixtureDBConfig.cmake" "set(FixtureDB_FOUND TRUE)\n")
file(WRITE "${db}/lib/pkgconfig/fixture-db.pc"
  "Name: fixture-db\nDescription: Database fixture\nVersion: 0.1.0\nLibs:\nCflags:\n")
file(WRITE "${db}/lib/pkgconfig/fixture-db-existing.pc"
  "Name: fixture-db-existing\nDescription: Database fixture\nVersion: 0.1.0\nLibs:\nCflags:\nRequires: fixture-private\n")
file(WRITE "${db}/lib/pkgconfig/fixture-private.pc"
  "Name: fixture-private\nDescription: Private fixture\nVersion: 1.0.0\nLibs:\nCflags:\n")
set(CPKT_CORE_PREFIX "${prefix}")
set(_stage_root "${db}")
set(CPKT_METADATA_CMAKE FixtureDB)
set(CPKT_METADATA_PC fixture-db fixture-db-existing)
include("${CPKT_ROOT}/cmake/sdk-discovery.cmake")
file(WRITE "${work}/components.json" "[]")
find_program(PYTHON python3 REQUIRED)
find_program(PKG_CONFIG pkg-config REQUIRED)
cpkt_test_command("${PYTHON}" "${CPKT_ROOT}/tools/generate_sdk_manifest.py"
  --prefix "${db}" --components "${work}/components.json"
  --inventory "${CPKT_ROOT}/cmake/components.json" --version 0.1.0
  --target x86_64-linux-gnu --tool unused --core-manifest "${prefix}/share/cpkt/packages/core.json")
file(READ "${db}/share/cpkt/packages/db.json" db_manifest)
string(JSON count LENGTH "${db_manifest}" requires_core)
string(JSON requirement_version GET "${db_manifest}" requires_core release_version)
string(JSON requirement_target GET "${db_manifest}" requires_core target_id)
string(JSON provenance_id GET "${db_manifest}" built_with_core package_id)
string(JSON provenance_version GET "${db_manifest}" built_with_core release_version)
string(JSON provenance_target GET "${db_manifest}" built_with_core target_id)
if(NOT count EQUAL 2 OR NOT requirement_version STREQUAL "0.3.0"
    OR NOT requirement_target STREQUAL "x86_64-linux-gnu" OR NOT provenance_id STREQUAL built_id
    OR NOT provenance_version STREQUAL "0.3.0" OR NOT provenance_target STREQUAL requirement_target)
  message(FATAL_ERROR "Build provenance and consumer requirement were not separated")
endif()
file(READ "${db}/share/doc/cpkt/db/README.md" readme)
if(NOT readme MATCHES "core >= 0.3.0")
  message(FATAL_ERROR "Installed README lacks the consumer minimum")
endif()
file(WRITE "${work}/db-source/CMakeLists.txt" [=[cmake_minimum_required(VERSION 3.21)
project(independent_sdk NONE)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_ROOT_PATH "${PREFIX}" "${CORE}")
set(CMAKE_PREFIX_PATH "${PREFIX}" "${CORE}")
find_package(FixtureDB CONFIG REQUIRED)
]=])
function(consumer core label)
  cpkt_test_command("${CMAKE_COMMAND}" -S "${work}/db-source" -B "${work}/${label}"
    "-DPREFIX=${db}" "-DCORE=${core}"
    -DCPKT_TARGET_ID=x86_64-linux-gnu -DCPKT_EXPECTED_VERSION=0.1.0)
endfunction()
function(reject_consumer core label diagnostic)
  cpkt_test_failure("${diagnostic}" "${CMAKE_COMMAND}" -S "${work}/db-source" -B "${work}/${label}"
    "-DPREFIX=${db}" "-DCORE=${core}")
endfunction()
consumer("${prefix}" baseline)
if(EXISTS "${db}/share/cpkt/packages/core.json" OR EXISTS "${prefix}/share/cpkt/packages/db.json")
  message(FATAL_ERROR "Independent SDK validation merged provider payloads")
endif()
reject_consumer("${work}/missing" missing-core CpktCore)
foreach(version 0.3.1 0.4.0 1.0.0)
  set(upgrade "${work}/core-${version}")
  core_fixture("${upgrade}" "${version}" 0.2.0 x86_64-linux-gnu)
  if(core_id STREQUAL built_id)
    message(FATAL_ERROR "Upgraded core has the baseline package identity")
  endif()
  consumer("${upgrade}" "upgrade-${version}")
endforeach()
set(upgrade "${work}/core-1.0.0")
file(WRITE "${upgrade}/include/sample.h" "corrupt\n")
reject_consumer("${upgrade}" corrupt-upgrade "SDK payload differs")
file(WRITE "${upgrade}/include/sample.h" "int sample(void);\n")
consumer("${upgrade}" repaired-upgrade)
string(REPLACE "1.0.0" "1.0.1" corrupt "${core_manifest}")
file(WRITE "${upgrade}/share/cpkt/packages/core.json" "${corrupt}")
reject_consumer("${upgrade}" corrupt-manifest "manifest identity mismatch")
file(WRITE "${upgrade}/share/cpkt/packages/core.json" "${core_manifest}")
core_fixture("${work}/breaking" 1.0.0 0.4.0 x86_64-linux-gnu)
reject_consumer("${work}/breaking" breaking-floor CpktCore)
core_fixture("${work}/floor-boundary" 0.4.0 0.3.0 x86_64-linux-gnu)
consumer("${work}/floor-boundary" inclusive-floor)
core_fixture("${work}/too-old" 0.2.9 0.2.0 x86_64-linux-gnu)
reject_consumer("${work}/too-old" below-minimum CpktCore)
core_fixture("${work}/wrong-arch" 0.4.0 0.2.0 aarch64-linux-gnu)
reject_consumer("${work}/wrong-arch" wrong-arch "SDK architecture mismatch")
core_fixture("${work}/wrong-libc" 0.4.0 0.2.0 x86_64-linux-musl)
reject_consumer("${work}/wrong-libc" wrong-libc "SDK prerequisite target mismatch")

# Direct archive validation also checks the supplied core and the minimum.
file(WRITE "${work}/direct.cmake"
  "include(\"${CPKT_ROOT}/cmake/CpktSDKValidate.cmake\")\n"
  "_cpktdb_sdk_validate_prefix(\"${db}\" db)\n")
cpkt_test_failure("SDK requires core >= 0.3.0" "${CMAKE_COMMAND}"
  "-DCPKT_CORE_PREFIX=${work}/too-old" -P "${work}/direct.cmake")
file(WRITE "${db}/include/db.h" "corrupt\n")
reject_consumer("${prefix}" corrupt-database "SDK payload differs")
file(WRITE "${db}/include/db.h" "int database(void);\n")
consumer("${prefix}" repaired-database)

# pkg-config resolves both newly added and appended >= requirements.
foreach(version 0.2.9 0.3.0 0.4.0 1.0.0)
  set(pc "${work}/pc-${version}")
  file(MAKE_DIRECTORY "${pc}")
  file(WRITE "${pc}/cpkt-core.pc"
    "Name: cpkt-core\nDescription: Core identity fixture\nVersion: ${version}\nLibs:\nCflags:\n")
  foreach(package fixture-db fixture-db-existing)
    set(command "${CMAKE_COMMAND}" -E env --unset=PKG_CONFIG_PATH --unset=PKG_CONFIG_SYSROOT_DIR
      "PKG_CONFIG_LIBDIR=${db}/lib/pkgconfig:${pc}" "${PKG_CONFIG}" --exists "${package}")
    if(version VERSION_LESS 0.3.0)
      execute_process(COMMAND ${command} RESULT_VARIABLE status)
      if(status EQUAL 0)
        message(FATAL_ERROR "pkg-config accepted a core below the minimum")
      endif()
    else()
      cpkt_test_command(${command})
    endif()
  endforeach()
endforeach()

# A newer compatible SDK must still fail the producer's exact build pin.
set(pin_root "${work}/pin-root")
file(MAKE_DIRECTORY "${pin_root}/dependencies")
file(READ "${CPKT_ROOT}/dependencies/cpkt.json" pins)
string(JSON pins SET "${pins}" targets x86_64-linux-gnu package_id "\"${built_id}\"")
file(WRITE "${pin_root}/dependencies/cpkt.json" "${pins}")
file(WRITE "${work}/build-pin.cmake"
  "include(\"${CPKT_ROOT}/cmake/CpktCore.cmake\")\n"
  "cpkt_validate_core(\"${pin_root}\" x86_64-linux-gnu \"\${PREFIX}\" manifest)\n")
cpkt_test_command("${CMAKE_COMMAND}" "-DPREFIX=${prefix}" -P "${work}/build-pin.cmake")
cpkt_test_failure("Pinned core package_id mismatch" "${CMAKE_COMMAND}"
  "-DPREFIX=${upgrade}" -P "${work}/build-pin.cmake")
file(READ "${db}/share/cpkt/packages/db.json" after_upgrades)
if(NOT after_upgrades STREQUAL db_manifest)
  message(FATAL_ERROR "Consumer upgrades changed the database manifest or build provenance")
endif()
file(RENAME "${prefix}" "${work}/relocated core SDK")
file(RENAME "${db}" "${work}/relocated database SDK")
set(db "${work}/relocated database SDK")
consumer("${work}/relocated core SDK" relocated)
