cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/sdk-validation")
file(REMOVE_RECURSE "${work}")
set(prefix "${work}/prefix with spaces")
file(MAKE_DIRECTORY "${prefix}/lib/cmake/CpktSDK" "${prefix}/lib/cmake/CpktCore" "${prefix}/include" "${prefix}/share/cpkt/packages" "${work}/source")
file(COPY_FILE "${CPKT_ROOT}/cmake/CpktSDKValidate.cmake" "${prefix}/lib/cmake/CpktSDK/Validate.cmake")
file(WRITE "${prefix}/lib/cmake/CpktCore/CpktCoreConfig.cmake" [=[
get_filename_component(CpktCore_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
_cpktdb_sdk_validate_prefix("${CpktCore_PREFIX}" core)
file(READ "${CpktCore_PREFIX}/share/cpkt/packages/core.json" manifest)
string(JSON CpktCore_VERSION GET "${manifest}" release_version)
string(JSON CpktCore_TARGET_ID GET "${manifest}" target_id)
string(JSON CpktCore_PACKAGE_ID GET "${manifest}" package_id)
]=])
include(CMakePackageConfigHelpers)
write_basic_package_version_file("${prefix}/lib/cmake/CpktCore/CpktCoreConfigVersion.cmake"
  VERSION 1.2.3 COMPATIBILITY ExactVersion ARCH_INDEPENDENT)
file(WRITE "${prefix}/include/sample.h" "int sample(void);\n")
file(WRITE "${work}/source/CMakeLists.txt" [=[cmake_minimum_required(VERSION 3.21)
project(sdk_validation NONE)
set(owned unrelated-caller-value)
set(link_targets unrelated-caller-value)
include("${PREFIX}/lib/cmake/CpktSDK/Validate.cmake")
cpktdb_sdk_validate(core)
]=])
set(files "")
foreach(path include/sample.h lib/cmake/CpktSDK/Validate.cmake
    lib/cmake/CpktCore/CpktCoreConfig.cmake lib/cmake/CpktCore/CpktCoreConfigVersion.cmake)
  file(CHMOD "${prefix}/${path}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  file(SHA256 "${prefix}/${path}" sha)
  string(APPEND files "${separator}{\"mode\":\"0644\",\"path\":\"${path}\",\"sha256\":\"${sha}\",\"type\":\"file\"}")
  set(separator ,)
endforeach()
set(before "{\"components\":[],\"files\":[${files}],\"group\":\"core\",\"libc\":\"gnu\",\"macos_deployment_target\":null,")
set(after "\"release_version\":\"1.2.3\",\"requires_core\":null,\"schema_version\":1,\"target_id\":\"x86_64-linux-gnu\"}")
string(SHA256 id "${before}${after}")
set(manifest "${before}\"package_id\":\"${id}\",${after}")
file(WRITE "${prefix}/share/cpkt/packages/core.json" "${manifest}")
set(configure "${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/graph" "-DPREFIX=${prefix}" -DCMAKE_SYSTEM_NAME=Linux)
cpkt_test_command(${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)
cpkt_test_failure("SDK target mismatch" ${configure} -DCPKT_TARGET_ID=aarch64-linux-gnu)
file(WRITE "${prefix}/include/sample.h" "changed\n")
cpkt_test_failure("SDK payload differs" ${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)
file(WRITE "${prefix}/include/sample.h" "int sample(void);\n")
cpkt_test_command(${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)
string(REPLACE "1.2.3" "1.2.4" corrupt "${manifest}")
file(WRITE "${prefix}/share/cpkt/packages/core.json" "${corrupt}")
cpkt_test_failure("manifest identity mismatch" ${configure} -DCPKT_TARGET_ID=x86_64-linux-gnu)

# An optional provider validates its own payload and an independent prerequisite.
file(WRITE "${prefix}/share/cpkt/packages/core.json" "${manifest}")
set(db "${work}/database SDK with spaces")
file(MAKE_DIRECTORY "${db}/lib/cmake/CpktDB" "${db}/include" "${db}/share/cpkt/packages" "${work}/db-source")
file(COPY_FILE "${CPKT_ROOT}/cmake/CpktSDKValidate.cmake" "${db}/lib/cmake/CpktDB/Validate.cmake")
file(WRITE "${db}/include/db.h" "int database(void);\n")
set(db_files "")
set(separator "")
foreach(path include/db.h lib/cmake/CpktDB/Validate.cmake)
  file(CHMOD "${db}/${path}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  file(SHA256 "${db}/${path}" sha)
  string(APPEND db_files "${separator}{\"mode\":\"0644\",\"path\":\"${path}\",\"sha256\":\"${sha}\",\"type\":\"file\"}")
  set(separator ,)
endforeach()
set(db_before "{\"components\":[],\"files\":[${db_files}],\"group\":\"db\",\"libc\":\"gnu\",\"macos_deployment_target\":null,")
set(db_after "\"release_version\":\"0.1.0\",\"requires_core\":{\"package_id\":\"${id}\",\"release_version\":\"1.2.3\",\"target_id\":\"x86_64-linux-gnu\"},\"schema_version\":1,\"target_id\":\"x86_64-linux-gnu\"}")
string(SHA256 db_id "${db_before}${db_after}")
file(WRITE "${db}/share/cpkt/packages/db.json" "${db_before}\"package_id\":\"${db_id}\",${db_after}")
file(WRITE "${work}/db-source/CMakeLists.txt" [=[cmake_minimum_required(VERSION 3.21)
project(independent_sdk NONE)
include("${PREFIX}/lib/cmake/CpktDB/Validate.cmake")
cpktdb_sdk_validate(db)
]=])
set(db_configure "${CMAKE_COMMAND}" -S "${work}/db-source" -B "${work}/db-graph"
  "-DPREFIX=${db}" "-DCMAKE_PREFIX_PATH=${prefix}" -DCPKT_TARGET_ID=x86_64-linux-gnu)
cpkt_test_command(${db_configure})
if(EXISTS "${db}/share/cpkt/packages/core.json" OR EXISTS "${prefix}/share/cpkt/packages/db.json")
  message(FATAL_ERROR "Independent SDK validation merged provider payloads")
endif()
cpkt_test_failure("CpktCore" ${db_configure}
  "-DCpktCore_DIR=${work}/missing" "-DCMAKE_PREFIX_PATH=${work}/missing")
string(REPLACE "1.2.3" "1.2.4" other_after "${after}")
string(SHA256 other_id "${before}${other_after}")
file(WRITE "${prefix}/share/cpkt/packages/core.json" "${before}\"package_id\":\"${other_id}\",${other_after}")
cpkt_test_failure("SDK release version mismatch" ${db_configure}
  "-DCpktCore_DIR=${prefix}/lib/cmake/CpktCore")
file(WRITE "${prefix}/share/cpkt/packages/core.json" "${manifest}")
cpkt_test_command(${db_configure})
# A package config alone cannot satisfy an incorrect package identity.
string(REPLACE "${id}" "${other_id}" wrong_requirement "${db_after}")
string(SHA256 wrong_id "${db_before}${wrong_requirement}")
file(WRITE "${db}/share/cpkt/packages/db.json" "${db_before}\"package_id\":\"${wrong_id}\",${wrong_requirement}")
cpkt_test_failure("SDK prerequisite mismatch" ${db_configure})
file(WRITE "${db}/share/cpkt/packages/db.json" "${db_before}\"package_id\":\"${db_id}\",${db_after}")
cpkt_test_command(${db_configure})
