cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_BINARY}/sdk-destdir-test")
file(REMOVE_RECURSE "${work}")
set(logical "${work}/logical prefix")
set(destdir "${work}/staging root")
set(staged "${destdir}${logical}")
cpkt_test_command("${CMAKE_COMMAND}" -E env "DESTDIR=${destdir}"
  "${CMAKE_COMMAND}" --install "${CPKT_BINARY}" --prefix "${logical}")
if(EXISTS "${logical}" OR EXISTS "${destdir}${staged}")
  message(FATAL_ERROR "DESTDIR install escaped staging or applied DESTDIR twice")
endif()
set(direct "${work}/direct prefix")
cpkt_test_command("${CMAKE_COMMAND}" -E env --unset=DESTDIR
  "${CMAKE_COMMAND}" --install "${CPKT_BINARY}" --prefix "${direct}")
file(READ "${staged}/share/cpkt/packages/db.json" staged_manifest)
file(READ "${direct}/share/cpkt/packages/db.json" direct_manifest)
if(NOT staged_manifest STREQUAL direct_manifest)
  message(FATAL_ERROR "DESTDIR changed the installed SDK inventory or identity")
endif()
file(GLOB_RECURSE files RELATIVE "${direct}" LIST_DIRECTORIES FALSE "${direct}/*")
file(GLOB_RECURSE staged_files RELATIVE "${staged}" LIST_DIRECTORIES FALSE "${staged}/*")
if(NOT files STREQUAL staged_files)
  message(FATAL_ERROR "DESTDIR changed the installed SDK payload")
endif()
foreach(path IN LISTS files)
  if(IS_SYMLINK "${direct}/${path}")
    file(READ_SYMLINK "${direct}/${path}" expected)
    file(READ_SYMLINK "${staged}/${path}" actual)
  else()
    file(SHA256 "${direct}/${path}" expected)
    file(SHA256 "${staged}/${path}" actual)
  endif()
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "DESTDIR changed installed bytes/link: ${path}")
  endif()
endforeach()
file(REMOVE_RECURSE "${work}")
