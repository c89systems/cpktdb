cmake_minimum_required(VERSION 3.21)
function(decision_count entry)
  set(count 0)
  foreach(key IN LISTS ARGN)
    string(JSON value ERROR_VARIABLE absent GET "${entry}" "${key}")
    if(NOT absent)
      math(EXPR count "${count}+1")
    endif()
  endforeach()
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Ambiguous binding decision: ${entry}")
  endif()
endfunction()
foreach(provider postgres sqlite)
  file(READ "${CPKT_DATA}/${CPKT_TARGET}/facade-${provider}.json" facade)
  file(READ "${CPKT_DATA}/${CPKT_TARGET}/native-${provider}.json" native)
  foreach(kind native facade)
    file(READ "${CPKT_SOURCE}/tests/contracts/db_${kind}_api.json" baseline)
    set(facts "${${kind}}")
    string(JSON facts REMOVE "${facts}" string_values)
    if(kind STREQUAL "facade")
      string(JSON facts REMOVE "${facts}" macros)
    endif()
    string(JSON actual GET "${facts}")
    string(JSON expected GET "${baseline}" "${CPKT_TARGET}" "${provider}")
    if(NOT actual STREQUAL expected)
      foreach(section functions records record_order typedefs variables enums enum_order layouts macros)
        string(JSON left ERROR_VARIABLE absent GET "${facts}" "${section}")
        string(JSON right ERROR_VARIABLE missing GET "${expected}" "${section}")
        if(NOT absent AND NOT missing AND NOT left STREQUAL right)
          message(FATAL_ERROR "${provider} ${kind} ${section} drift: ${CPKT_DATA}/${CPKT_TARGET}/${kind}-${provider}.json")
        endif()
      endforeach()
      message(FATAL_ERROR "${provider} ${kind} API schema drift")
    endif()
  endforeach()
  set(names "")
  set(accessible "")
  string(JSON count LENGTH "${facade}" functions)
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${facade}" functions ${index})
    list(APPEND names "${name}")
    list(APPEND accessible "${name}")
  endforeach()
  file(STRINGS "${CPKT_SOURCE}/cmake/exports/cpkt_${provider}.txt" catalog)
  list(SORT catalog)
  list(SORT names)
  if(NOT names STREQUAL catalog)
    message(FATAL_ERROR "${provider} export catalog differs from public declarations")
  endif()
  string(JSON count LENGTH "${facade}" records)
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON record MEMBER "${facade}" records ${index})
    string(REGEX REPLACE "^[^:]*:" "" type "${record}")
    string(JSON fields LENGTH "${facade}" records "${record}")
    math(EXPR end "${fields}-1")
    foreach(field_index RANGE 0 ${end})
      string(JSON field MEMBER "${facade}" records "${record}" ${field_index})
      list(APPEND accessible "${type}.${field}")
    endforeach()
  endforeach()
  foreach(pair "function|functions" "variable|variables" "record|records" "typedef|typedefs" "enum|enums" "constant|macros")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 decision)
    list(GET pair 1 section)
    file(READ "${CPKT_SOURCE}/tests/contracts/db_${decision}_bindings.json" bindings)
    string(JSON count LENGTH "${native}" "${section}")
    string(JSON decisions LENGTH "${bindings}" "${provider}")
    if(NOT count EQUAL decisions)
      message(FATAL_ERROR "${provider} incomplete ${decision} decisions")
    endif()
    if(count EQUAL 0)
      continue()
    endif()
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      string(JSON name MEMBER "${native}" "${section}" ${index})
      string(JSON entry GET "${bindings}" "${provider}" "${name}")
      if(decision STREQUAL "enum")
        string(JSON actual GET "${facade}" enums "${entry}")
        string(JSON expected GET "${native}" enums "${name}")
        if(NOT actual STREQUAL expected)
          message(FATAL_ERROR "${provider} enum binding drift: ${name}")
        endif()
      elseif(decision STREQUAL "record")
        string(JSON fields LENGTH "${native}" records "${name}")
        string(JSON bound_fields LENGTH "${entry}")
        if(NOT fields EQUAL bound_fields)
          message(FATAL_ERROR "Missing record field decisions: ${name}")
        endif()
        math(EXPR end "${fields}-1")
        foreach(field_index RANGE 0 ${end})
          string(JSON field MEMBER "${native}" records "${name}" ${field_index})
          string(JSON mapping GET "${entry}" "${field}")
          decision_count("${mapping}" facade fixed exclude)
          string(JSON mapped ERROR_VARIABLE absent GET "${mapping}" facade)
          if(NOT absent AND NOT mapped IN_LIST accessible)
            message(FATAL_ERROR "Missing facade record binding: ${name}.${field}")
          endif()
        endforeach()
      else()
        if(decision STREQUAL "typedef")
          decision_count("${entry}" facade scalar exclude)
          string(JSON mapped ERROR_VARIABLE absent GET "${entry}" facade)
          if(NOT absent)
            string(JSON type GET "${facade}" typedefs "${mapped}")
          endif()
        else()
          if(decision STREQUAL "constant")
            decision_count("${entry}" facade equivalent exclude)
            string(JSON actual GET "${native}" macros "${name}")
            string(JSON expected GET "${entry}" native_value)
            if(NOT actual STREQUAL expected)
              message(FATAL_ERROR "Native constant binding changed: ${name}")
            endif()
          else()
            decision_count("${entry}" facade exclude)
          endif()
          string(JSON mapped ERROR_VARIABLE absent GET "${entry}" facade)
          if(NOT absent AND decision MATCHES "^(function|variable)$")
            string(JSON mappings LENGTH "${entry}" facade)
            if(mappings GREATER 0)
              math(EXPR end "${mappings}-1")
              foreach(mapping_index RANGE 0 ${end})
                string(JSON mapped GET "${entry}" facade ${mapping_index})
                if(NOT mapped IN_LIST accessible)
                  message(FATAL_ERROR "Missing callable facade binding: ${name} -> ${mapped}")
                endif()
              endforeach()
            endif()
          elseif(NOT absent AND decision STREQUAL "constant")
            string(JSON enum ERROR_VARIABLE no_enum GET "${facade}" enums "${mapped}")
            if(no_enum)
              string(JSON actual GET "${facade}" macros "${mapped}")
              string(JSON native_value GET "${native}" macros "${name}")
              string(JSON expected ERROR_VARIABLE no_value GET "${entry}" facade_value)
              if(NOT no_value)
                if(expected MATCHES "^\"")
                  string(JSON expected GET "${expected}")
                  string(JSON actual GET "${facade}" string_values "${mapped}")
                else()
                  string(REGEX REPLACE "[ \t\r\n]" "" actual "${actual}")
                  string(REGEX REPLACE "[ \t\r\n]" "" expected "${expected}")
                endif()
                if(NOT actual STREQUAL expected)
                  message(FATAL_ERROR "Facade constant changed: ${mapped}")
                endif()
              endif()
              if(native_value MATCHES "^\"")
                string(JSON native_string GET "${native}" string_values "${name}")
                string(JSON facade_string GET "${facade}" string_values "${mapped}")
                if(NOT native_string STREQUAL facade_string)
                  message(FATAL_ERROR "String constant binding changed: ${mapped}")
                endif()
              endif()
            endif()
          endif()
        endif()
      endif()
    endforeach()
  endforeach()
  if(provider STREQUAL "sqlite")
    file(READ "${CPKT_SOURCE}/tests/contracts/db_operation_bindings.json" operations)
    string(JSON macros GET "${native}" macros)
    set(macro_names "")
    string(JSON count LENGTH "${macros}")
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      string(JSON name MEMBER "${macros}" ${index})
      list(APPEND macro_names "${name}")
    endforeach()
    foreach(pair "global_config|SQLITE_CONFIG_" "database_config|SQLITE_DBCONFIG_"
        "virtual_table_config|SQLITE_VTAB_" "file_control|SQLITE_FCNTL_")
      string(REPLACE "|" ";" pair "${pair}")
      list(GET pair 0 group)
      list(GET pair 1 prefix)
      set(selectors "")
      foreach(name IN LISTS macro_names)
        if(name MATCHES "^${prefix}")
          list(APPEND selectors "${name}")
        endif()
      endforeach()
      list(LENGTH selectors count)
      string(JSON decisions LENGTH "${operations}" "${group}")
      if(NOT count EQUAL decisions)
        message(FATAL_ERROR "Incomplete sqlite ${group} operation decisions")
      endif()
      foreach(name IN LISTS selectors)
        string(JSON entry GET "${operations}" "${group}" "${name}")
        decision_count("${entry}" facade exclude)
        string(JSON mapped ERROR_VARIABLE absent GET "${entry}" facade)
        if(NOT absent AND NOT mapped IN_LIST accessible)
          message(FATAL_ERROR "Missing callable sqlite operation binding: ${name} -> ${mapped}")
        endif()
      endforeach()
    endforeach()
  endif()
endforeach()
