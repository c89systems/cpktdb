cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_BINARY}/stack-allocation-policy")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/bounded.c" "int sample(void) { int values[4] = {0}; return values[0]; }\n")
file(WRITE "${work}/vla.c" "int sample(int n) { int values[n]; values[0] = 1; return values[0]; }\n")
file(WRITE "${work}/alloca.c"
  "#include <alloca.h>\nint sample(int n) { void *p = alloca((unsigned int)n); return p != 0; }\n")
file(WRITE "${work}/builtin_alloca.c"
  "int sample(int n) { void *p = __builtin_alloca((unsigned int)n); return p != 0; }\n")
file(READ "${CPKT_BINARY}/compile_commands.json" commands)
string(JSON count LENGTH "${commands}")
math(EXPR last "${count}-1")
set(checked 0)
foreach(index RANGE 0 ${last})
  string(JSON entry GET "${commands}" ${index})
  string(JSON command GET "${entry}" command)
  if(NOT command MATCHES "CMakeFiles/cpkt_(postgres|sqlite)_(static|shared)[.]dir/src/(postgres|sqlite)[.]c[.]o")
    continue()
  endif()
  separate_arguments(arguments UNIX_COMMAND "${command}")
  # Replace only the output and source operands of the real facade command.
  list(FIND arguments "-o" output_index)
  math(EXPR output_value "${output_index}+1")
  list(REMOVE_AT arguments ${output_value} ${output_index})
  list(POP_BACK arguments source)
  string(JSON directory GET "${entry}" directory)
  execute_process(COMMAND ${arguments} "${work}/bounded.c" -o "${work}/bounded.o"
    WORKING_DIRECTORY "${directory}" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Bounded array failed under facade flags: ${output}${error}")
  endif()
  foreach(kind vla alloca builtin_alloca)
    set(warning alloca)
    if(kind STREQUAL "vla")
      set(warning vla)
    endif()
    execute_process(COMMAND ${arguments} "${work}/${kind}.c" -o "${work}/${kind}.o"
      WORKING_DIRECTORY "${directory}" RESULT_VARIABLE status
      OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(status EQUAL 0 OR NOT error MATCHES "\\[-W(error=|error,-W)?${warning}")
      message(FATAL_ERROR "Facade flags did not reject ${kind}: ${output}${error}")
    endif()
  endforeach()
  math(EXPR checked "${checked}+1")
endforeach()
if(NOT checked EQUAL 4)
  message(FATAL_ERROR "Expected all four facade compile policies, checked ${checked}")
endif()
