cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/zip-archive-reuse")
file(REMOVE_RECURSE "${work}")
set(prefix "${work}/payload")
set(archive "${work}/fixture.zip")
function(stage reverse)
  file(REMOVE_RECURSE "${prefix}")
  file(MAKE_DIRECTORY "${prefix}/nested")
  set(names sample executable)
  if(reverse)
    list(REVERSE names)
  endif()
  foreach(name IN LISTS names)
    file(WRITE "${prefix}/${name}" "${name} bytes\n")
  endforeach()
  file(CHMOD "${prefix}" "${prefix}/nested" "${prefix}/executable"
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  file(CHMOD "${prefix}/sample" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
endfunction()
function(pack timezone mask)
  cpkt_test_command("${CMAKE_COMMAND}" -E env "TZ=${timezone}" bash -c
    "umask ${mask}\nexec bash \"$1\" \"$2\" \"$3\"" bash
    "${CPKT_ROOT}/scripts/zip-archive.sh" "${prefix}" "${archive}")
endfunction()
stage(FALSE)
pack(UTC 022)
file(SHA256 "${archive}" original)
file(TIMESTAMP "${archive}" before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
stage(TRUE)
pack(GMT+7 077)
file(SHA256 "${archive}" repeated)
file(TIMESTAMP "${archive}" after "%s")
if(NOT original STREQUAL repeated OR NOT before STREQUAL after)
  message(FATAL_ERROR "ZIP bytes/reuse changed with staging times, order, timezone or umask")
endif()
# A leftover temporary archive must never retain an extra entry on an update.
file(WRITE "${prefix}/extra" "stale bytes\n")
pack(UTC 022)
file(RENAME "${archive}" "${archive}.tmp")
file(REMOVE "${prefix}/extra")
pack(UTC 022)
file(SHA256 "${archive}" restored)
if(NOT restored STREQUAL original)
  message(FATAL_ERROR "ZIP creation retained stale temporary payload")
endif()
file(WRITE "${prefix}/sample" "changed bytes\n")
pack(UTC 022)
file(SHA256 "${archive}" changed)
if(changed STREQUAL original)
  message(FATAL_ERROR "Changed ZIP payload reused stale bytes")
endif()
file(WRITE "${work}/bin/zip" "#!/usr/bin/env bash\nprintf 'injected ZIP failure\\n' >&2\nexit 42\n")
file(CHMOD "${work}/bin/zip" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
cpkt_test_failure("injected ZIP failure" "${CMAKE_COMMAND}" -E env "PATH=${work}/bin:$ENV{PATH}"
  bash "${CPKT_ROOT}/scripts/zip-archive.sh" "${prefix}" "${archive}")
file(SHA256 "${archive}" preserved)
if(NOT preserved STREQUAL changed OR EXISTS "${archive}.tmp")
  message(FATAL_ERROR "Failed ZIP creation changed final bytes or retained temporary output")
endif()
