cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/checksum-scope")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
set(binary cpktdb-1.2.3-x86_64-linux-gnu.tar.gz)
set(source cpktdb-1.2.3.tar.gz)
file(WRITE "${work}/${binary}" "binary bytes")
file(WRITE "${work}/${source}" "source bytes")
file(SHA256 "${work}/${binary}" binary_hash)
file(SHA256 "${work}/${source}" source_hash)
set(manifest "${work}/CHECKSUMS")
set(command "${CMAKE_COMMAND}" "-DCPKT_BASE=${work}" "-DCPKT_MANIFEST=${manifest}"
  -DCPKT_VERSION=1.2.3)
set(check -P "${CPKT_ROOT}/cmake/verify-checksums.cmake")
file(WRITE "${manifest}" "${binary_hash}  ${binary}\n")
cpkt_test_command(${command} -DCPKT_SCOPE=binary "-DCPKT_FILES=${binary}" ${check})
cpkt_test_failure("Stale/unlisted" ${command} -DCPKT_SCOPE=selected "-DCPKT_FILES=${binary}" ${check})
cpkt_test_failure("Incomplete" ${command} -DCPKT_SCOPE=release "-DCPKT_FILES=${binary}\\;${source}" ${check})
# Warm checks preserve identified artifacts belonging to other versions,
# including a version whose text starts with the selected version.
set(unrelated cpktdb-1.2.2.tar.gz cpktdb-1.2.2-x86_64-linux-gnu.tar.gz
  cpktdb-1.2.2-arm64-apple-darwin-smoke-test.zip cpktdb-1.2.30-x86_64-linux-gnu.tar.gz
  cpktdb-2.0.0-armhf-linux-musl.tar.gz cpktdb-1.2.2-CHECKSUMS)
foreach(name IN LISTS unrelated)
  file(WRITE "${work}/${name}" "preserved ${name}")
  file(SHA256 "${work}/${name}" "before_${name}")
endforeach()
cpkt_test_command(${command} -DCPKT_SCOPE=binary "-DCPKT_FILES=${binary}" ${check})
file(REMOVE "${work}/${source}")
cpkt_test_command(${command} -DCPKT_SCOPE=selected "-DCPKT_FILES=${binary}" ${check})
file(WRITE "${work}/${source}" "source bytes")
foreach(name IN LISTS unrelated)
  file(SHA256 "${work}/${name}" actual)
  if(NOT actual STREQUAL "${before_${name}}")
    message(FATAL_ERROR "Warm checksum verification modified an unrelated artifact: ${name}")
  endif()
endforeach()
# Foreign versions must not enter the selected checksum inventory.
file(SHA256 "${work}/cpktdb-1.2.2.tar.gz" old_hash)
file(APPEND "${manifest}" "${old_hash}  cpktdb-1.2.2.tar.gz\n")
cpkt_test_failure("Unexpected/duplicate" ${command} -DCPKT_SCOPE=binary "-DCPKT_FILES=${binary}" ${check})
file(WRITE "${manifest}" "${binary_hash}  ${binary}\n")
# A complete release still rejects every unlisted release-looking archive.
file(APPEND "${manifest}" "${source_hash}  ${source}\n")
cpkt_test_failure("Stale/unlisted" ${command} -DCPKT_SCOPE=release "-DCPKT_FILES=${binary}\\;${source}" ${check})
foreach(name IN LISTS unrelated)
  file(REMOVE "${work}/${name}")
endforeach()
file(WRITE "${manifest}" "${binary_hash}  ${binary}\n")
file(REMOVE "${work}/${source}")
foreach(extra cpktdb-1.2.3-extra.zip cpktdb-1.2.3-extra.tar.gz
    cpktdb-1.2.3x-x86_64-linux-gnu.tar.gz cpktdb-unversioned.tar.gz)
  file(WRITE "${work}/${extra}" "unexpected artifact")
  cpkt_test_failure("Stale/unlisted" ${command} -DCPKT_SCOPE=binary "-DCPKT_FILES=${binary}" ${check})
  cpkt_test_failure("Stale/unlisted" ${command} -DCPKT_SCOPE=selected "-DCPKT_FILES=${binary}" ${check})
  file(REMOVE "${work}/${extra}")
endforeach()
file(WRITE "${work}/${source}" "source bytes")
file(APPEND "${manifest}" "${binary_hash}  ${binary}\n")
cpkt_test_failure("Unexpected/duplicate" ${command} -DCPKT_SCOPE=binary "-DCPKT_FILES=${binary}" ${check})
file(WRITE "${manifest}" "${binary_hash}  ${binary}\n")
file(APPEND "${work}/${binary}" "changed")
cpkt_test_failure("Checksum mismatch" ${command} -DCPKT_SCOPE=binary "-DCPKT_FILES=${binary}" ${check})
file(WRITE "${work}/${binary}" "binary bytes")
file(REMOVE "${work}/${binary}")
cpkt_test_failure("file SHA256" ${command} -DCPKT_SCOPE=binary "-DCPKT_FILES=${binary}" ${check})
file(WRITE "${work}/${binary}" "binary bytes")
file(WRITE "${manifest}" "${binary_hash}  ${binary}\n${source_hash}  ${source}\n")
cpkt_test_command(${command} -DCPKT_SCOPE=release "-DCPKT_FILES=${binary}\\;${source}" ${check})
file(APPEND "${work}/${source}" "changed")
cpkt_test_failure("Checksum mismatch" ${command} -DCPKT_SCOPE=release "-DCPKT_FILES=${binary}\\;${source}" ${check})
