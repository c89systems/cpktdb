cmake_minimum_required(VERSION 3.21)
set(work "${CPKT_BINARY}/contract-mutations")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/source/tests" "${work}/source/cmake" "${work}/data")
file(COPY "${CPKT_SOURCE}/tests/contracts" DESTINATION "${work}/source/tests")
file(COPY "${CPKT_SOURCE}/cmake/exports" DESTINATION "${work}/source/cmake")
file(COPY "${CPKT_BINARY}/api/${CPKT_TARGET}" DESTINATION "${work}/data")
function(check expected diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCPKT_SOURCE=${work}/source"
    "-DCPKT_DATA=${work}/data" "-DCPKT_TARGET=${CPKT_TARGET}"
    -P "${CPKT_SOURCE}/tests/db_api_contract_test.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL "pass" AND NOT result EQUAL 0)
    message(FATAL_ERROR "Valid API fixture rejected: ${output}${error}")
  elseif(expected STREQUAL "fail" AND (result EQUAL 0 OR NOT error MATCHES "${diagnostic}"))
    message(FATAL_ERROR "API mutation was not rejected for ${diagnostic}: ${output}${error}")
  endif()
endfunction()
check(pass "")
set(path "${work}/data/${CPKT_TARGET}/facade-postgres.json")
