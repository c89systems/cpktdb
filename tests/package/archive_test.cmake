cmake_minimum_required(VERSION 3.21)
include("${CPKT_SOURCE}/cmake/extract-release-archive.cmake")
include("${CPKT_SOURCE}/cmake/CpktSDKValidate.cmake")
include("${CPKT_SOURCE}/cmake/package_inspection.cmake")
include("${CPKT_SOURCE}/tests/privacy_scan.cmake")
include("${CPKT_SOURCE}/cmake/CpktCore.cmake")
cpkt_extract_release_archive("${CPKT_ARCHIVE}" "${CPKT_PREFIX}"
  "cpktdb-${CPKT_VERSION}-${CPKT_TARGET}" TRUE)
set(core_prefix "${CPKT_SOURCE}/.cache/cpkt/${CPKT_TARGET}/install")
cpkt_validate_core("${CPKT_SOURCE}" "${CPKT_TARGET}" "${core_prefix}" core_manifest)
file(READ "${CPKT_PREFIX}/share/cpkt/packages/db.json" db_manifest)
string(JSON count LENGTH "${db_manifest}" files)
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON relative GET "${db_manifest}" files ${index} path)
  if(EXISTS "${core_prefix}/${relative}" OR IS_SYMLINK "${core_prefix}/${relative}")
    message(FATAL_ERROR "Core/database payload collision: ${relative}")
  endif()
endforeach()
set(CPKT_CORE_PREFIX "${core_prefix}")
set(CPKT_TARGET_ID "${CPKT_TARGET}")
set(CPKT_EXPECTED_VERSION "${CPKT_VERSION}")
_cpktdb_sdk_validate_prefix("${CPKT_PREFIX}" db)
get_property(owned GLOBAL PROPERTY "CPKT_PAYLOAD_PATHS_${_cpktdb_sdk_key}")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${CPKT_PREFIX}" "${CPKT_PREFIX}/*")
list(SORT files)
list(SORT owned)
if(NOT files STREQUAL owned)
  message(FATAL_ERROR "Archive payload differs from its manifest inventory")
endif()
set(CPKT_ROOT "${CPKT_SOURCE}")
cpkt_assert_tree_has_no_private_traces("${CPKT_PREFIX}" "SDK")
if(CPKT_TARGET MATCHES "^aarch64")
  set(machine AArch64)
elseif(CPKT_TARGET MATCHES "^armhf")
  set(machine ARM)
else()
  set(machine "(X86-64|x86-64)")
endif()
foreach(relative IN LISTS files)
  set(file "${CPKT_PREFIX}/${relative}")
  if(IS_SYMLINK "${file}")
    continue()
  endif()
  file(STRINGS "${file}" private_traces REGEX "/home/|/Users/|/private/tmp/|\\.cache/cpkt/|libpslog")
  if(relative STREQUAL "include/sqlite3.h")
    # SQLite's pinned public header documents this fictional URI example.
    # Remove only that exact path from scanning, preserving all shipped bytes.
    string(REPLACE "/home/fred/data.db" "" private_traces "${private_traces}")
    if(NOT private_traces MATCHES "/home/|/Users/|/private/tmp/|\\.cache/cpkt/|libpslog")
      set(private_traces "")
    endif()
  endif()
  if(private_traces)
    message(FATAL_ERROR "Private or test-only payload in ${relative}")
  endif()
  file(READ "${file}" magic LIMIT 4 HEX)
  if(magic STREQUAL "7f454c46" OR (CPKT_TARGET MATCHES "-linux-" AND relative MATCHES "\\.a$"))
    execute_process(COMMAND "${CPKT_TOOL}" -h "${file}"
      RESULT_VARIABLE result OUTPUT_VARIABLE header ERROR_VARIABLE error)
    string(REGEX MATCHALL "Machine:[^\n]+" machines "${header}")
    if(NOT result EQUAL 0 OR NOT machines)
      message(FATAL_ERROR "Wrong ELF architecture: ${relative}\n${error}")
    endif()
    foreach(actual_machine IN LISTS machines)
      if(NOT actual_machine MATCHES "${machine}")
        message(FATAL_ERROR "Wrong ELF archive member architecture: ${relative}: ${actual_machine}")
      endif()
    endforeach()
    set(CPKT_READELF "${CPKT_TOOL}")
    if(magic STREQUAL "7f454c46")
      cpkt_assert_elf_runtime_metadata_file_relocatable("${file}" "${relative}")
    endif()
  elseif(CPKT_TARGET MATCHES "darwin$" AND (magic STREQUAL "cffaedfe" OR relative MATCHES "\\.a$"))
    execute_process(COMMAND "${CPKT_TOOL}" -hv "${file}" RESULT_VARIABLE result OUTPUT_VARIABLE header)
    string(REGEX MATCHALL "MH_MAGIC[^\n]+" machines "${header}")
    if(NOT result EQUAL 0 OR NOT machines)
      message(FATAL_ERROR "Wrong Mach-O architecture: ${relative}")
    endif()
    foreach(actual_machine IN LISTS machines)
      if(NOT actual_machine MATCHES "ARM64")
        message(FATAL_ERROR "Wrong Mach-O archive member architecture: ${relative}: ${actual_machine}")
      endif()
    endforeach()
    set(CPKT_OTOOL "${CPKT_TOOL}")
    if(magic STREQUAL "cffaedfe")
      cpkt_assert_darwin_dylib_relocatable("${file}" "${relative}")
      cpkt_assert_darwin_deployment_target("${file}" "15.0" "${relative}")
    endif()
  endif()
endforeach()

foreach(provider postgres sqlite)
  if(CPKT_TARGET MATCHES "darwin$")
    set(format macho)
    set(suffix .dylib)
  else()
    set(format elf)
    set(suffix .so)
  endif()
  execute_process(COMMAND bash "${CPKT_SOURCE}/tests/db_export_policy_test.sh" "${provider}"
    "${CPKT_PREFIX}/lib/libcpkt_${provider}${suffix}"
    "${CPKT_SOURCE}/cmake/exports/cpkt_${provider}.txt" "${format}" "${CPKT_NM}" "${CPKT_PREFIX}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Packaged facade export/import boundary failed: ${output}${error}")
  endif()
endforeach()
