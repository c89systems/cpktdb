cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
include("${CPKT_ROOT}/cmake/CpktMutationPaths.cmake")
set(work "${CPKT_BINARY}/sdk-core-upgrade")
cpkt_validate_mutation_paths("${work}")
file(REMOVE_RECURSE "${work}")
set(db "${work}/database SDK")
set(core "${CPKT_ROOT}/.cache/cpkt/x86_64-linux-gnu/install")
cpkt_test_command("${CMAKE_COMMAND}" -E env --unset=DESTDIR
  "${CMAKE_COMMAND}" --install "${CPKT_BINARY}" --prefix "${db}")
file(READ "${db}/share/cpkt/packages/db.json" before)
string(JSON built_id GET "${before}" built_with_core package_id)
file(READ "${core}/share/cpkt/packages/core.json" original_core)
string(JSON original_id GET "${original_core}" package_id)
if(NOT built_id STREQUAL original_id)
  message(FATAL_ERROR "Upgrade proof must start from the exact producer core")
endif()
find_program(PYTHON python3 REQUIRED)
find_program(PKG_CONFIG pkg-config REQUIRED)
function(assert_provider_unchanged)
  file(READ "${db}/share/cpkt/packages/db.json" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Consumer upgrade changed the provider manifest")
  endif()
  string(JSON count LENGTH "${before}" files)
  math(EXPR last "${count} - 1")
  set(static_count 0)
  set(shared_count 0)
  foreach(index RANGE 0 ${last})
    string(JSON path GET "${before}" files ${index} path)
    string(JSON type GET "${before}" files ${index} type)
    if(type STREQUAL "file")
      file(SHA256 "${db}/${path}" actual)
      string(JSON expected GET "${before}" files ${index} sha256)
      if(path MATCHES "^lib/.*[.]a$")
        math(EXPR static_count "${static_count} + 1")
      elseif(path MATCHES "^lib/.*[.]so([.]|$)")
        math(EXPR shared_count "${shared_count} + 1")
      endif()
    else()
      file(READ_SYMLINK "${db}/${path}" actual)
      string(JSON expected GET "${before}" files ${index} target)
    endif()
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Consumer upgrade changed the provider payload: ${path}")
    endif()
  endforeach()
  if(static_count LESS 1 OR shared_count LESS 1)
    message(FATAL_ERROR "Upgrade proof requires actual static archives and shared libraries")
  endif()
endfunction()
set(configure "${CMAKE_COMMAND}" -E env CPKT_RESOLVED_TARGET=x86_64-linux-gnu
  "${CMAKE_COMMAND}" -S "${CPKT_ROOT}/tests/sdk-consumers/native"
  -G "Unix Makefiles" "-DCPKT_SOURCE=${CPKT_ROOT}" "-DCPKT_PREFIX=${db}"
  "-DCMAKE_TOOLCHAIN_FILE=${CPKT_ROOT}/cmake/CpktReadOnlyToolchain.cmake"
  -DCPKT_TARGET_ID=x86_64-linux-gnu -DCPKT_CAN_RUN_CONSUMERS=ON)
foreach(phase baseline compatible)
  if(phase STREQUAL "baseline")
    set(selected_core "${core}")
  else()
    set(selected_core "${work}/newer core SDK")
    file(COPY "${core}/" DESTINATION "${selected_core}")
    cpkt_test_command("${PYTHON}" "${CPKT_ROOT}/tests/fixtures/core_upgrade.py"
      --prefix "${selected_core}" --version 0.4.0 --floor 0.3.0)
    file(READ "${selected_core}/share/cpkt/packages/core.json" upgraded)
    string(JSON upgraded_id GET "${upgraded}" package_id)
    if(upgraded_id STREQUAL built_id)
      message(FATAL_ERROR "Upgrade fixture retained the producer core identity")
    endif()
  endif()
  set(graph "${work}/${phase}-consumers")
  # This graph validates CMake compatibility before any pkg-config query.
  cpkt_test_command(${configure} -B "${graph}" "-DCPKT_CORE_PREFIX=${selected_core}")
  cpkt_test_command("${CMAKE_COMMAND}" --build "${graph}" --parallel "${CPKT_JOBS}")
  cpkt_test_command("${CMAKE_CTEST_COMMAND}" --test-dir "${graph}"
    --no-tests=error --stop-on-failure --output-on-failure)
  message(STATUS "${phase} installed static/shared CMake and pkg-config consumers:\n${CPKT_TEST_OUTPUT}")
  # Revalidate every provider payload digest, including the actual libraries,
  # and prove that neither consumer phase rewrites its metadata or provenance.
  assert_provider_unchanged()
endforeach()

# pkg-config's minimum alone accepts this breaking release. The mandatory
# CMake preflight must reject it before generating any consumer build rules.
cpkt_test_command("${PYTHON}" "${CPKT_ROOT}/tests/fixtures/core_upgrade.py"
  --prefix "${selected_core}" --version 0.5.0 --floor 0.5.0)
cpkt_test_command("${CMAKE_COMMAND}" -E env --unset=PKG_CONFIG_PATH --unset=PKG_CONFIG_SYSROOT_DIR
  "PKG_CONFIG_LIBDIR=${db}/lib/pkgconfig:${selected_core}/lib/pkgconfig"
  "${PKG_CONFIG}" --exists cpkt-sqlite)
cpkt_test_failure("CpktCore" ${configure} -B "${work}/breaking-consumers"
  "-DCPKT_CORE_PREFIX=${selected_core}")
if(EXISTS "${work}/breaking-consumers/Makefile")
  message(FATAL_ERROR "Breaking core generated a consumer build graph")
endif()
assert_provider_unchanged()
