+/* cpkt: these supported targets have downward-growing native stacks. Cache
+** immutable OS-thread bounds in TLS; do not cache them on a database handle,
+** which may be used serially by different workers. Reserve 32 KiB for error
+** reporting and destruction while recursive compiler frames unwind.
+*/
+#include <stdint.h>
+#include <pthread.h>
+static __thread uintptr_t sqlite3NativeStackLimit;
+static __thread Parse *sqlite3NativeParse;
+
+static SQLITE_NOINLINE uintptr_t sqlite3NativeStackInit(void){
+  uintptr_t low = 0;
+  size_t size = 0;
+#if defined(__linux__)
+  pthread_attr_t attr;
+  void *base = 0;
+  if( pthread_getattr_np(pthread_self(), &attr)==0 ){
+    int rc = pthread_attr_getstack(&attr, &base, &size);
+    pthread_attr_destroy(&attr);
+    if( rc==0 ) low = (uintptr_t)base;
+    else size = 0;
+  }
+#elif defined(__APPLE__)
+  uintptr_t high = (uintptr_t)pthread_get_stackaddr_np(pthread_self());
+  size = pthread_get_stacksize_np(pthread_self());
+  if( high>=size ) low = high-size;
+  else size = 0;
+#else
+#error Unsupported SQLite native stack platform
+#endif
+  if( size>32768 && low<=UINTPTR_MAX-size ) return low+32768;
+  return UINTPTR_MAX;
+}
+
+static int sqlite3NativeStackAvailable(void){
+  uintptr_t position;
+  uintptr_t limit = sqlite3NativeStackLimit;
+#if defined(__x86_64__)
+  __asm__ volatile("mov %%rsp, %0" : "=r"(position));
+#elif defined(__aarch64__) || defined(__arm__)
+  __asm__ volatile("mov %0, sp" : "=r"(position));
+#else
+#error Unsupported SQLite native stack architecture
+#endif
+  if( limit==0 || limit==UINTPTR_MAX ){
+    sqlite3NativeStackLimit = limit = sqlite3NativeStackInit();
+  }
+  return position>limit;
+}
+
+static int sqlite3NativeStackCheck(Parse *pParse){
+  if( sqlite3NativeStackAvailable() ) return 1;
+  if( pParse==0 ) pParse = sqlite3NativeParse;
+  if( sqlite3NativeParse ) sqlite3NativeParse->nativeStackError = 1;
+  if( pParse ) pParse->nativeStackError = 1;
+  if( pParse && pParse->nErr==0 ){
+    sqlite3ErrorMsg(pParse, "native stack budget exhausted");
+  }
+  return 0;
+}
