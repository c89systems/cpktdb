# Only database-owned metadata is emitted or adjusted by this provider.
file(READ "${CPKT_CORE_PREFIX}/share/cpkt/packages/core.json" _core)
string(JSON _core_version GET "${_core}" release_version)
set(_validation_preamble [=[include("${CMAKE_CURRENT_LIST_DIR}/../CpktDB/Validate.cmake")
cpktdb_sdk_validate(db)
cpktdb_sdk_assert_targets(db)
]=])
foreach(_package IN LISTS CPKT_METADATA_CMAKE)
  file(GLOB_RECURSE _configs "${_stage_root}/lib/cmake/${_package}/*.cmake")
  foreach(_config IN LISTS _configs)
    if(_config MATCHES "(Config|config)[.]cmake$" AND NOT _config MATCHES "(ConfigVersion|config-version)[.]cmake$")
      file(READ "${_config}" _content)
      string(PREPEND _content "${_validation_preamble}")
      string(APPEND _content "\ncpktdb_sdk_assert_targets(db)\n")
      file(WRITE "${_config}" "${_content}")
    endif()
  endforeach()
endforeach()
foreach(_name IN LISTS CPKT_METADATA_PC)
  set(_pc "${_stage_root}/lib/pkgconfig/${_name}.pc")
  file(READ "${_pc}" _content)
  if(_content MATCHES "(^|\n)Requires:([^\n]*)")
    string(REGEX REPLACE "(^|\n)Requires:([^\n]*)" "\\1Requires:\\2, cpkt-core = ${_core_version}" _content "${_content}")
  else()
    string(APPEND _content "Requires: cpkt-core = ${_core_version}\n")
  endif()
  file(WRITE "${_pc}" "${_content}")
endforeach()
