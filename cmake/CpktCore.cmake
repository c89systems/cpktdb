include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CpktSDKValidate.cmake")

function(cpkt_read_core_pin root target)
  if(NOT target MATCHES "^(x86_64|aarch64|armhf)-linux-(gnu|musl)$" AND
      NOT target STREQUAL "arm64-apple-darwin")
    message(FATAL_ERROR "Unsupported core target: ${target}")
  endif()
  file(READ "${root}/dependencies/cpkt.json" pins)
  string(JSON schema GET "${pins}" schema_version)
  string(JSON repository GET "${pins}" repository)
  string(JSON version GET "${pins}" version)
  string(JSON pin ERROR_VARIABLE missing GET "${pins}" targets "${target}")
  if(NOT schema EQUAL 1 OR NOT repository STREQUAL "c89systems/cpkt" OR missing)
    message(FATAL_ERROR "Exact published core pin required for ${target}")
  endif()
  if(NOT version MATCHES "^[0-9]+[.][0-9]+[.][0-9]+$")
    message(FATAL_ERROR "Invalid core release version")
  endif()
  set(name "cpkt-${version}-${target}.tar.gz")
  string(JSON count LENGTH "${pin}")
  string(JSON url GET "${pin}" url)
  if(NOT count EQUAL 3 OR NOT url STREQUAL
      "https://github.com/${repository}/releases/download/v${version}/${name}")
    message(FATAL_ERROR "Invalid core archive identity: ${target}")
  endif()
  foreach(field sha256 package_id)
    string(JSON value GET "${pin}" "${field}")
    string(LENGTH "${value}" length)
    if(NOT length EQUAL 64 OR NOT value MATCHES "^[a-f0-9]+$")
      message(FATAL_ERROR "Invalid pinned core ${field}")
    endif()
    set(CPKT_CORE_${field} "${value}" PARENT_SCOPE)
  endforeach()
  set(CPKT_CORE_VERSION "${version}" PARENT_SCOPE)
  set(CPKT_CORE_NAME "${name}" PARENT_SCOPE)
  set(CPKT_CORE_URL "${url}" PARENT_SCOPE)
endfunction()

function(cpkt_validate_core root target prefix output)
  cpkt_read_core_pin("${root}" "${target}")
  if(IS_SYMLINK "${prefix}" OR NOT IS_DIRECTORY "${prefix}")
    message(FATAL_ERROR "Published core SDK missing. Prepare: make deps-core PRESET=${target}-release")
  endif()
  file(READ "${prefix}/share/cpkt/packages/core.json" manifest)
  foreach(field package_id release_version target_id)
    string(JSON actual GET "${manifest}" "${field}")
    if(field STREQUAL "package_id")
      set(expected "${CPKT_CORE_package_id}")
    elseif(field STREQUAL "release_version")
      set(expected "${CPKT_CORE_VERSION}")
    else()
      set(expected "${target}")
    endif()
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Pinned core ${field} mismatch; prepare make deps-core for ${target}")
    endif()
  endforeach()
  set(CPKT_TARGET_ID "${target}")
  set(CPKT_EXPECTED_VERSION "${CPKT_CORE_VERSION}")
  _cpktdb_sdk_validate_prefix("${prefix}" core)
  get_property(owned GLOBAL PROPERTY "CPKT_PAYLOAD_PATHS_${_cpktdb_sdk_key}")
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${prefix}" "${prefix}/*")
  list(SORT files)
  list(SORT owned)
  if(NOT files STREQUAL owned)
    message(FATAL_ERROR "Core SDK has undeclared payload")
  endif()
  set(${output} "${manifest}" PARENT_SCOPE)
endfunction()
